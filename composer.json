{
    "name": "duyler/parallel",
    "type": "library",
    "description": "Parallel extension wrapper",
    "license": "MIT",
    "keywords": [
        "php",
        "parallel",
        "ext-parallel"
    ],
    "authors": [
        {
            "name": "Mikhail Ilinsky",
            "email": "mail@milinsky.ru"
        }
    ],
    "support": {
        "docs": "https://duyler.org/en/docs/parallel/"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.80",
        "vimeo/psalm": "^6.10",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Duyler\\Parallel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duyler\\Parallel\\Test\\": ["tests/"]
        }
    }
}
